{
  "mcpServers": {
    "UnityMCP": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--offline",
        "--from",
        "mcpforunityserver==10.3.0",
        "mcp-for-unity"
      ],
      "env": {},
      "timeout": 180000
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-for-blender"
      ],
      "env": {}
    }
  }
}
