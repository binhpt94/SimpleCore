kind: ui
title: Cheat chọn đội: đội đủ 3, nút vào trận sáng
use tap = feature-hud/hud-layout/layout-spec#tap
use safe = feature-hud/hud-layout/layout-spec#safe
use back-w = feature-team-select/team-slots/slots-spec#back-w
use title-x = feature-team-select/team-slots/slots-spec#title-x
use title-w = feature-team-select/team-slots/slots-spec#title-w
use cards-x = feature-team-select/team-slots/slots-spec#cards-x
use cards-y = feature-team-select/team-slots/slots-spec#cards-y
use card-w = feature-team-select/team-slots/slots-spec#card-w
use card-h = feature-team-select/team-slots/slots-spec#card-h
use card-gap = feature-team-select/team-slots/slots-spec#card-gap
use slots-x = feature-team-select/team-slots/slots-spec#slots-x
use row-y = feature-team-select/team-slots/slots-spec#row-y
use slot = feature-team-select/team-slots/slots-spec#slot
use slot-gap = feature-team-select/team-slots/slots-spec#slot-gap
use start-x = feature-team-select/team-slots/slots-spec#start-x
use start-y = feature-team-select/team-slots/slots-spec#start-y
use start-w = feature-team-select/team-slots/slots-spec#start-w
use start-h = feature-team-select/team-slots/slots-spec#start-h
use portrait-x = feature-team-select/hero-cards/card-spec#portrait-x
use portrait-y = feature-team-select/hero-cards/card-spec#portrait-y
use portrait-w = feature-team-select/hero-cards/card-spec#portrait-w
use portrait-h = feature-team-select/hero-cards/card-spec#portrait-h
use text-x = feature-team-select/hero-cards/card-spec#text-x
use text-w = feature-team-select/hero-cards/card-spec#text-w
use name-y = feature-team-select/hero-cards/card-spec#name-y
use name-h = feature-team-select/hero-cards/card-spec#name-h
use style-y = feature-team-select/hero-cards/card-spec#style-y
use style-h = feature-team-select/hero-cards/card-spec#style-h
use role-y = feature-team-select/hero-cards/card-spec#role-y
use role = feature-team-select/hero-cards/card-spec#role
use picked-x = feature-team-select/hero-cards/card-spec#picked-x
use picked-y = feature-team-select/hero-cards/card-spec#picked-y
use picked = feature-team-select/hero-cards/card-spec#picked
- back     button     x=safe y=safe w=back-w h=tap label="Quay lại"
- title    label      x=title-x y=safe w=title-w h=tap label="Chọn đội"
- cards    grid       x=cards-x y=cards-y cols=5 rows=1 cw=card-w ch=card-h gap=card-gap label="Hiệp sĩ ✓, Đấu sĩ rìu ✓, Kiếm khách, Cung thủ ✓, Pháp sư"
- portrait rect       x=portrait-x y=portrait-y w=portrait-w h=portrait-h parent=cards label="Hình hero (thẻ Hiệp sĩ, ô đầu)"
- name     label      x=text-x y=name-y w=text-w h=name-h parent=cards label="Hiệp sĩ"
- style    label      x=text-x y=style-y w=text-w h=style-h parent=cards label="Cận chiến · Chắn"
- role     icon       x=text-x y=role-y w=role h=role parent=cards label="Dấu cận chiến"
- picked   icon       x=picked-x y=picked-y w=picked h=picked parent=cards overlap label="Đã chọn"
- slots    grid       x=slots-x y=row-y cols=3 rows=1 cell=slot gap=slot-gap label="Hiệp sĩ · Đấu sĩ rìu · Cung thủ"
- start    button     x=start-x y=start-y w=start-w h=start-h label="Vào trận (sáng)"
