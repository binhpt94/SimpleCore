kind: ui
title: Cheat popup hồi sinh: đang chờ quảng cáo
use panel-x = feature-popup/popup-layer/stack-rules#panel-x
use panel-y = feature-popup/popup-layer/stack-rules#panel-y
use panel-w = feature-popup/popup-layer/stack-rules#panel-w
use panel-h = feature-popup/popup-layer/stack-rules#panel-h
use tap = feature-hud/hud-layout/layout-spec#tap
use text-x = feature-popup-revive/revive-popup/revive-spec#text-x
use text-w = feature-popup-revive/revive-popup/revive-spec#text-w
use title-y = feature-popup-revive/revive-popup/revive-spec#title-y
use title-h = feature-popup-revive/revive-popup/revive-spec#title-h
use row-h = feature-popup-revive/revive-popup/revive-spec#row-h
use gain-y = feature-popup-revive/revive-popup/revive-spec#gain-y
use wait-y = feature-popup-revive/revive-popup/revive-spec#wait-y
use btn-y = feature-popup-revive/revive-popup/revive-spec#btn-y
use watch-x = feature-popup-revive/revive-popup/revive-spec#watch-x
use watch-w = feature-popup-revive/revive-popup/revive-spec#watch-w
use end-x = feature-popup-revive/revive-popup/revive-spec#end-x
use end-w = feature-popup-revive/revive-popup/revive-spec#end-w
- backdrop  rect       x=0 y=0 w=1920 h=1080 label="Nền che (trận đứng yên phía sau)"
- panel     round-rect x=panel-x y=panel-y w=panel-w h=panel-h overlap label="Popup hồi sinh"
- title     label      x=text-x y=title-y w=text-w h=title-h parent=panel label="Thành đã bị phá"
- gain      label      x=text-x y=gain-y w=text-w h=row-h parent=panel label="Xem quảng cáo để thành hồi 30% máu và chơi tiếp"
- wait      label      x=text-x y=wait-y w=text-w h=row-h parent=panel label="Đang chờ quảng cáo..."
- watch     button     x=watch-x y=btn-y w=watch-w h=tap parent=panel label="Xem quảng cáo (khoá)"
- end       button     x=end-x y=btn-y w=end-w h=tap parent=panel label="Kết thúc lượt (khoá)"
