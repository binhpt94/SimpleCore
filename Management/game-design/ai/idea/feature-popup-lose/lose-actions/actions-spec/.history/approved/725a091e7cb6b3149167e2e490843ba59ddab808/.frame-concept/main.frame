kind: ui
title: Popup thua: hai nút
use panel-x = feature-popup/popup-layer/stack-rules#panel-x
use panel-y = feature-popup/popup-layer/stack-rules#panel-y
use panel-w = feature-popup/popup-layer/stack-rules#panel-w
use panel-h = feature-popup/popup-layer/stack-rules#panel-h
use tap = feature-hud/hud-layout/layout-spec#tap
use text-x = feature-popup-lose/lose-result/result-spec#text-x
use text-w = feature-popup-lose/lose-result/result-spec#text-w
use title-y = feature-popup-lose/lose-result/result-spec#title-y
use title-h = feature-popup-lose/lose-result/result-spec#title-h
use row-h = feature-popup-lose/lose-result/result-spec#row-h
use score-y = feature-popup-lose/lose-result/result-spec#score-y
use record-y = feature-popup-lose/lose-result/result-spec#record-y
let btn-y = 540
let replay-x = 50
let replay-w = 400
let home-x = 490
let home-w = 260
- backdrop  rect       x=0 y=0 w=1920 h=1080 label="Nền che (trận đứng yên phía sau)"
- panel     round-rect x=panel-x y=panel-y w=panel-w h=panel-h overlap label="Popup thua"
- title     label      x=text-x y=title-y w=text-w h=title-h parent=panel label="Thành đã bị phá"
- score     label      x=text-x y=score-y w=text-w h=row-h parent=panel label="Trụ được 12 đợt"
- record    label      x=text-x y=record-y w=text-w h=row-h parent=panel label="Kỉ lục: 15 đợt"
- replay    button     x=replay-x y=btn-y w=replay-w h=tap parent=panel label="Chơi lại (nút chính)"
- home      button     x=home-x y=btn-y w=home-w h=tap parent=panel label="Về màn bắt đầu"
