kind: ui
title: Cheat nhân vật Spine: đang chạy, quay mặt phải
use tap = feature-hud/hud-layout/layout-spec#tap
use top-h = feature-hud/hud-layout/layout-spec#top-h
use btn-w = feature-spine-test/spine-checks/spine-spec#btn-w
use col1-x = feature-spine-test/spine-checks/spine-spec#col1-x
use col2-x = feature-spine-test/spine-checks/spine-spec#col2-x
use row1-y = feature-spine-test/spine-checks/spine-spec#row1-y
use row2-y = feature-spine-test/spine-checks/spine-spec#row2-y
use state-x = feature-spine-test/spine-checks/spine-spec#state-x
use state-y = feature-spine-test/spine-checks/spine-spec#state-y
use state-w = feature-spine-test/spine-checks/spine-spec#state-w
use state-h = feature-spine-test/spine-checks/spine-spec#state-h
- top          rect   x=0 y=0 w=1920 h=top-h label="Mép trên của HUD (feature-hud)"
- strip        rect   x=0 y=top-h w=1920 h=760 label="Dải chiến trường"
- spine-idle   button x=col1-x y=row1-y w=btn-w h=tap parent=strip label="Đứng"
- spine-run    button x=col2-x y=row1-y w=btn-w h=tap parent=strip label="Chạy (đang chọn)"
- spine-jump   button x=col1-x y=row2-y w=btn-w h=tap parent=strip label="Nhảy"
- spine-flip   button x=col2-x y=row2-y w=btn-w h=tap parent=strip label="Lật"
- spine-state  label  x=state-x y=state-y w=state-w h=state-h parent=strip label="run · lặp · mặt phải"
- spine-char   rect   x=1470 y=610 w=60 h=90 parent=strip label="Nhân vật Spine đang chạy, quay mặt phải (x=+9u, chân ở mặt đất px 840)"
