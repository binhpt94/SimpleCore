kind: ui
title: Ba ô thông tin trận và thông báo đợt
use top-h = feature-hud/hud-layout/layout-spec#top-h
let info-y = 10
let info-h = 60
let coin-x = 220
let coin-w = 60
let money-x = 290
let money-w = 230
let hp-x = 660
let hp-w = 600
let hp-num-x = 180
let hp-num-y = 5
let hp-num-w = 240
let hp-num-h = 50
let wave-x = 1580
let wave-w = 300
let banner-x = 760
let banner-y = 76
let banner-w = 400
let banner-h = 56
- top        rect  x=0    y=0  w=1920 h=top-h label="Mép trên"
- coin       icon  x=coin-x  y=info-y w=coin-w  h=info-h parent=top label="xu"
- money      label x=money-x y=info-y w=money-w h=info-h parent=top label="50"
- hp         bar   x=hp-x    y=info-y w=hp-w    h=info-h fill=1 parent=top label="Máu thành"
- hp-number  label x=hp-num-x y=hp-num-y w=hp-num-w h=hp-num-h parent=hp overlap label="1000/1000"
- wave       label x=wave-x  y=info-y w=wave-w  h=info-h parent=top label="Đợt 1"
- banner     label x=banner-x y=banner-y w=banner-w h=banner-h parent=top label="Đợt N (hiện 1.5 giây)"
