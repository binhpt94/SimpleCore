kind: ui
title: Cheat dịch vụ popup: popup mẫu của dịch vụ
use panel-x = feature-popup/popup-layer/stack-rules#panel-x
use panel-y = feature-popup/popup-layer/stack-rules#panel-y
use panel-w = feature-popup/popup-layer/stack-rules#panel-w
use panel-h = feature-popup/popup-layer/stack-rules#panel-h
use tap = feature-hud/hud-layout/layout-spec#tap
- below     rect       x=0 y=0 w=1920 h=1080 label="Scene đang chạy bên dưới (không nhận bấm)"
- backdrop  rect       x=0 y=0 w=1920 h=1080 overlap label="Nền che: tối 60%, chặn mọi chạm"
- panel     round-rect x=panel-x y=panel-y w=panel-w h=panel-h overlap label="Popup mẫu _Services/Popup/DevSample (khung trống)"
- close     button     x=270 y=540 w=260 h=tap parent=panel label="Đóng"
