kind: ui
title: Lớp popup: nền che và khung popup
let panel-x = 560            # khung popup chuẩn, giữa màn 1920x1080
let panel-y = 190
let panel-w = 800
let panel-h = 700
- hud       rect       x=0       y=0       w=1920    h=1080 label="Màn chơi và HUD bên dưới (không nhận bấm)"
- backdrop  rect       x=0       y=0       w=1920    h=1080 overlap label="Nền che: tối 60%, chặn mọi chạm"
- panel     round-rect x=panel-x y=panel-y w=panel-w h=panel-h overlap label="Popup trên cùng (nhận chạm)"
