kind: ui
title: Popup tạm dừng: bước hỏi xác nhận
use panel-x = feature-popup/popup-layer/stack-rules#panel-x
use panel-y = feature-popup/popup-layer/stack-rules#panel-y
use panel-w = feature-popup/popup-layer/stack-rules#panel-w
use panel-h = feature-popup/popup-layer/stack-rules#panel-h
use tap = feature-hud/hud-layout/layout-spec#tap
- panel     round-rect x=panel-x y=panel-y w=panel-w h=panel-h label="Popup tạm dừng (cùng popup)"
- question  label      x=50  y=100 w=700 h=200 parent=panel label="Bỏ lượt này? Điểm tính theo số đợt đã dọn."
- quit      button     x=60  y=540 w=320 h=tap parent=panel label="Bỏ lượt"
- no        button     x=420 y=540 w=320 h=tap parent=panel label="Không (nút chính)"
