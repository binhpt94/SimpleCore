   ],
   "play": "",
   "hash": "b7d590b1ab07",
   "text": "State thuộc scene trận cần đội: state tự ép đủ giá trị nó cần như khi chọn trên asset; panel không ép thêm.",
   "title": "State thuộc scene trận cần đội",
   "by": "@CodeLead",
   "at": "2026-11-27 16:22:40"
  },
