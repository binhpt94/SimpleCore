kind: ui
title: Bố cục HUD trận (16:9)
let tap = 120                # cạnh ngắn tối thiểu của nút chạm trong HUD và popup
let safe = 40                # lề an toàn hai cạnh trái, phải
let top-h = 140              # chiều cao dải trên
let bottom-h = 180           # chiều cao dải dưới
let skill = 140              # cạnh nút kĩ năng thành
let up-w = 200               # rộng nút nâng cấp
let up-h = 140               # cao nút nâng cấp
- top      rect   x=0    y=0   w=1920 h=top-h label="Mép trên"
- strip    rect   x=0    y=140 w=1920 h=760 label="Dải chiến trường (không HUD nào chồng lên)"
- bottom   rect   x=0    y=900 w=1920 h=bottom-h label="Mép dưới"
- pause    button x=safe y=10  w=tap  h=tap parent=top label="Tạm dừng"
- money    label  x=220  y=10  w=300  h=60  parent=top label="Tiền"
- hp       bar    x=660  y=10  w=600  h=60  fill=1 parent=top label="Máu thành"
- wave     label  x=1580 y=10  w=300  h=60  parent=top label="Đợt"
- banner   label  x=760  y=76  w=400  h=56  parent=top label="Thông báo Đợt N"
- upgrade  rect   x=safe y=15  w=1340 h=150 parent=bottom label="Thanh nâng cấp (feature-hud-upgrade)"
- skills   grid   x=1420 y=20  cols=3 rows=1 cell=skill gap=20 parent=bottom label="3 nút kĩ năng"
