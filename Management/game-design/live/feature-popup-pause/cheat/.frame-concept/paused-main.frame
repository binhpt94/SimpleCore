kind: ui
title: Cheat popup tạm dừng: bước chính
use panel-x = feature-popup/popup-layer/stack-rules#panel-x
use panel-y = feature-popup/popup-layer/stack-rules#panel-y
use panel-w = feature-popup/popup-layer/stack-rules#panel-w
use panel-h = feature-popup/popup-layer/stack-rules#panel-h
use tap = feature-hud/hud-layout/layout-spec#tap
use title-x = feature-popup-pause/pause-popup/pause-popup-spec#title-x
use title-y = feature-popup-pause/pause-popup/pause-popup-spec#title-y
use title-w = feature-popup-pause/pause-popup/pause-popup-spec#title-w
use title-h = feature-popup-pause/pause-popup/pause-popup-spec#title-h
use btn-y = feature-popup-pause/pause-popup/pause-popup-spec#btn-y
use btn-w = feature-popup-pause/pause-popup/pause-popup-spec#btn-w
use left-x = feature-popup-pause/pause-popup/pause-popup-spec#left-x
use right-x = feature-popup-pause/pause-popup/pause-popup-spec#right-x
- backdrop  rect       x=0 y=0 w=1920 h=1080 label="Nền che (trận đứng yên phía sau)"
- panel     round-rect x=panel-x y=panel-y w=panel-w h=panel-h overlap label="Popup tạm dừng"
- title     label      x=title-x y=title-y w=title-w h=title-h parent=panel label="Tạm dừng"
- resume    button     x=left-x y=btn-y w=btn-w h=tap parent=panel label="Tiếp tục (nút chính)"
- quit      button     x=right-x y=btn-y w=btn-w h=tap parent=panel label="Bỏ lượt"
