kind: ui
title: Popup thua: hai nút
use panel-x = feature-popup/popup-layer/stack-rules#panel-x
use panel-y = feature-popup/popup-layer/stack-rules#panel-y
use panel-w = feature-popup/popup-layer/stack-rules#panel-w
use panel-h = feature-popup/popup-layer/stack-rules#panel-h
use tap = feature-hud/hud-layout/layout-spec#tap
- panel    round-rect x=panel-x y=panel-y w=panel-w h=panel-h label="Popup thua"
- result   rect       x=50  y=40  w=700 h=370 parent=panel label="Chữ kết quả (result-spec)"
- replay   button     x=60  y=540 w=320 h=tap parent=panel label="Chơi lại (nút chính)"
- home     button     x=420 y=540 w=320 h=tap parent=panel label="Về màn bắt đầu"
