kind: ui
title: Cheat nhân vật Spine: hero và quái đứng chồng hình lên nhân vật idle
use tap = feature-hud/hud-layout/layout-spec#tap
use top-h = feature-hud/hud-layout/layout-spec#top-h
use bottom-h = feature-hud/hud-layout/layout-spec#bottom-h
use btn-w = feature-spine-test/spine-checks/spine-spec#btn-w
use col1-x = feature-spine-test/spine-checks/spine-spec#col1-x
use col2-x = feature-spine-test/spine-checks/spine-spec#col2-x
use row1-y = feature-spine-test/spine-checks/spine-spec#row1-y
use row2-y = feature-spine-test/spine-checks/spine-spec#row2-y
use state-x = feature-spine-test/spine-checks/spine-spec#state-x
use state-y = feature-spine-test/spine-checks/spine-spec#state-y
use state-w = feature-spine-test/spine-checks/spine-spec#state-w
use state-h = feature-spine-test/spine-checks/spine-spec#state-h
- top          rect   x=0 y=0 w=1920 h=top-h label="HUD trên hiện đủ (feature-hud)"
- strip        rect   x=0 y=top-h w=1920 h=760 label="Dải chiến trường"
- bottom       rect   x=0 y=900 w=1920 h=bottom-h label="HUD dưới hiện đủ (feature-hud)"
- spine-idle   button x=col1-x y=row1-y w=btn-w h=tap parent=strip label="Đứng (đang chọn)"
- spine-run    button x=col2-x y=row1-y w=btn-w h=tap parent=strip label="Chạy"
- spine-jump   button x=col1-x y=row2-y w=btn-w h=tap parent=strip label="Nhảy"
- spine-flip   button x=col2-x y=row2-y w=btn-w h=tap parent=strip label="Lật"
- spine-state  label  x=state-x y=state-y w=state-w h=state-h parent=strip label="idle · lặp · mặt trái"
- spine-char   rect   x=1470 y=610 w=60 h=90 parent=strip overlap label="Nhân vật Spine idle, mặt trái (x=+9u, chân ở mặt đất px 840)"
- hero         rect   x=1470 y=610 w=60 h=90 parent=strip overlap label="Một hero (feature-hero, hộp 1u x 1.5u) đứng đúng chỗ nhân vật, không đi, không đánh"
- enemy        rect   x=1470 y=628 w=60 h=72 parent=strip overlap label="Một quái Lính (feature-enemy, hộp 1u x 1.2u) đứng đúng chỗ nhân vật, không đi, không đánh"
