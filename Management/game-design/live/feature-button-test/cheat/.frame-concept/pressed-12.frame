kind: ui
title: Cheat nút thử: đã bấm 12 lần
use tap = feature-hud/hud-layout/layout-spec#tap
use safe = feature-hud/hud-layout/layout-spec#safe
use top-h = feature-hud/hud-layout/layout-spec#top-h
use test-y = feature-button-test/test-button/button-spec#test-y
use test-w = feature-button-test/test-button/button-spec#test-w
use count-x = feature-button-test/test-button/button-spec#count-x
use count-y = feature-button-test/test-button/button-spec#count-y
use count-w = feature-button-test/test-button/button-spec#count-w
use count-h = feature-button-test/test-button/button-spec#count-h
- top           rect   x=0 y=0 w=1920 h=top-h label="Mép trên của HUD (feature-hud)"
- strip         rect   x=0 y=top-h w=1920 h=760 label="Dải chiến trường"
- test-button   button x=safe y=test-y w=test-w h=tap parent=strip label="Thử"
- test-counter  label  x=count-x y=count-y w=count-w h=count-h parent=strip label="Đã bấm: 12"
