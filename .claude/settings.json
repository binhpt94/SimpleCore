{
  "enabledMcpjsonServers": [
    "unityMCP"
  ],
  "env": {
    "CLAUDE_BG_ISOLATION": "none"
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "mcp__unityMCP",
      "mcp__UnityMCP",
      "Edit(/Management/**)"
    ],
    "ask": [
      "Edit(/UnityProject/Packages/**)",
      "Edit(/UnityProject/ProjectSettings/**)"
    ],
    "deny": [
      "Read(/UnityProject/Library/**)",
      "Read(/UnityProject/Temp/**)",
      "Read(/UnityProject/Logs/**)",
      "Read(/UnityProject/obj/**)",
      "Read(/UnityProject/UserSettings/**)",
      "Edit(/UnityProject/Library/**)",
      "Edit(/UnityProject/Temp/**)",
      "Edit(/UnityProject/Logs/**)",
      "Edit(/UnityProject/obj/**)",
      "Edit(/UnityProject/UserSettings/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_validate.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_report.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_unlock.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/Management/tools/sync_page.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/bind_session.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
