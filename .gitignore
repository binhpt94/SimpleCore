# Python
__pycache__/
*.pyc

# Cấu hình riêng từng máy
/.claude/settings.local.json
.DS_Store
Thumbs.db

# Trang quản lý: sinh bởi Management/tools/sync_page.py
/Management/data/project.js
/Management/data/project.js.tmp
/Management/data/gamedesign.js
/Management/data/gamedesign.js.tmp
/Management/data/studio.js
/Management/data/studio.js.tmp
/Management/data/references.js
/Management/data/references.js.tmp
/Management/game-design/.promote-*/
# Gói thiết kế và báo cáo status dài: gd_pack.py, gd_status.py ghi, tên kèm hash nội dung
/Management/game-design/.pack/

# Báo cáo cho @Manager: Stop hook stop_report.py ghi, nhật ký điều phối trên máy này
/Management/reports/
# Hộp thư của các thread chạy theo việc (dispatch.py, setup_server.py): trạng thái lúc chạy, không commit
/Management/inbox/

# Trung gian của studio.py claude (ảnh ghép có font nhúng, khoảng 1,4 MB mỗi lần chạy)
/Management/studio/**/work/_log/*.compose.svg
/Management/studio/**/work/_log/*.font.svg
/Management/studio/**/work/_made/

# Excel lock files (a workbook open in Excel)
~$*
